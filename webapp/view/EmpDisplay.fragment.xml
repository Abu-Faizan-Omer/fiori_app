<core:FragmentDefinition xmlns="sap.m"
 xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">

<VBox >
 <HBox >
  <Avatar active="true" press="onPressPhoto" src="/sap/opu/odata/sap/ZB70_EMP_SRV/PhotoSet('{Empid}')/$value" displaySize="L"></Avatar>
    <VBox class="sapUiMediumMargin">
      <Text text="{Name}"></Text>
      <Text text="{Design}"></Text>
    </VBox>
 </HBox>



 <f:SimpleForm id="idSF" title="Employee Details" editable="true" layout="ResponsiveGridLayout"
            lableSpanL="2" lableSpanM="2" emptySpanL="5" emptySpanM="5" >

            <f:content>
                <Label text="Employee ID" ></Label>
                <Text  text="{Empid}"></Text>
                <Label text="Name"  ></Label>
                <Text text="{Name}"></Text>
                 <Label text="Designation"></Label>
                <Text text="{Design}"></Text>
                 <Label text="Skill"  ></Label>
                <Text text="{Skill}"></Text>
                 <Label text="Email" ></Label>
                <Text text="{Email}"></Text>
                 <Label text="Phone No" ></Label>
                <Text text="{Phone}"></Text>
                 <Label text="Salary" ></Label>
                <Text text="{Salary}"></Text>
                 <Label text="Date of Joining" ></Label>
                <Text text="{Doj}"></Text>
                 <Label text="Status" ></Label>
                <Text text="{Status}"></Text>
                 <Label text="Rating" ></Label>
                <RatingIndicator value="{Rating}"></RatingIndicator>
            </f:content>

</f:SimpleForm>

<ScrollContainer horizontal="true" vertical="true">
 <Table items="{toProjects}" headerText="Project Information">
            <columns>
            <Column width="10rem">
            <Text text="Employee Id"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Project Code"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Client Name"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Project Name"></Text>
            </Column>
              <Column width="10rem">
            <Text text="Project Description"></Text>
            </Column>
             <Column width="10rem" >
            <Text text="Team Count"></Text>
            </Column>
            </columns >
            <items>
            <ColumnListItem >
           
            <cells>
            <Text text="{Empid}"></Text>
            <Text text="{Prjcode}"></Text>
            <Text text="{Clientname}"></Text>
            <Text text="{Prjname}"></Text>
            <Text text="{Prjdesc}"></Text>
            <Text text="{Teamsize}"></Text>
            </cells>
            </ColumnListItem>
           
           
            </items>
            </Table>
 </ScrollContainer>  

  <Table items="{toResumes}" headerText="Employee CV's">
            <columns>
              <Column >
              <Text text="Employee Id"></Text>
              </Column>
              <Column >
              <Text text="Resume"></Text>
              </Column>
              <Column >
              <Text text="Download"></Text>
              </Column>
            
            </columns >
            <items>
            <ColumnListItem >
           
            <cells>
            <Text text="{Empid}"></Text>
            <Text text="{Filename}"></Text>
            <Button icon="sap-icon://download" type="Reject" press="onPressDownload"></Button>
            </cells>
            </ColumnListItem>
           
           
            </items>
            </Table>         
   </VBox>         

</core:FragmentDefinition>
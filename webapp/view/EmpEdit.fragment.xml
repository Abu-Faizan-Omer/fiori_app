<core:FragmentDefinition xmlns="sap.m"
 xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">

<VBox >
<f:SimpleForm  title="Employee Details" editable="true" layout="ResponsiveGridLayout"
            lableSpanL="2" lableSpanM="2" emptySpanL="5" emptySpanM="5" >

           
             <f:content>
                <Label text="Employee ID" required="true"></Label>
                <Input id="idEmpId1" value="{Empid}"></Input>
                <Label  text="Name" required="true" ></Label>
                <Input id="idName1" value="{Name}"></Input>
                 <Label text="Designation" required="true"></Label>
                <Input id="idDesign1" value="{Design}"></Input>
                 <Label text="Skill" required="true" ></Label>
                <Input id="idSkill1" value="{Skill}"></Input>
                 <Label text="Email" required="true"></Label>
                <Input id="idEmail1" value="{Email}"></Input>
                 <Label text="Phone No" required="true"></Label>
                <Input id="idPhone1" value="{Phone}"></Input>
                 <Label text="Salary" required="true"></Label>
                <Input id="idSalary1" value="{Salary}"></Input>
                 <Label text="Date of Joining" required="true"></Label>
                <DatePicker id="idDoj1" dateValue="{Doj}"></DatePicker>
                 <Label text="Status" required="true"></Label>
                <Input id="idStatus1" value="{Status}"></Input>
                 <Label text="Rating" required="true"></Label>
                <RatingIndicator id="idRating1" value="{Rating}"></RatingIndicator>
            </f:content>

</f:SimpleForm>

<Table items="{editPrjModel>/results}">
<headerToolbar>
  <Toolbar >
    <Title text="Add Project"></Title>
    <ToolbarSpacer ></ToolbarSpacer>
    <Button icon="sap-icon://add" type="Emphasized" press="onPressAddRowForEdit"></Button>
  </Toolbar>
</headerToolbar>
  <columns>
    <Column >
      <Text text="Employee Id"></Text>
    </Column>
    <Column >
      <Text text="Project Code"></Text>
    </Column>
    <Column >
      <Text text="Client Name"></Text>
    </Column>
    <Column >
      <Text text="Project Name"></Text>
    </Column>
    <Column >
      <Text text="Description"></Text>
    </Column>
     <Column >
      <Text text="Team Size"></Text>
    </Column>
    <Column >
      <Text text="Delete"></Text>
    </Column>
  </columns>
  <items>
    <ColumnListItem >
      <cells>
        <Input value="{editPrjModel>Empid}"></Input>
        <Input value="{editPrjModel>Prjcode}"></Input>
        <Input value="{editPrjModel>Clientname}"></Input>
        <Input value="{editPrjModel>Prjname}"></Input>
        <Input value="{editPrjModel>Prjdesc}"></Input>
        <Input value="{editPrjModel>Teamsize}"></Input>
        <Button icon="sap-icon://delete" type="Reject" press="onPressDeleteRowForEdit"></Button>
      </cells>
    </ColumnListItem>
  </items>
</Table>
</VBox>

</core:FragmentDefinition>
    <Page id="page" title="I am View1">
        <content>
        <!-- //Multiple UI Element -->

        <f:SimpleForm title="Multi Value UI ELements" editable="true" layout="ResponsiveGridLayout"
            lableSpanL="2" lableSpanM="2" emptySpanL="5" emptySpanM="5" columnsL="3" columnsM="2">

            
            <f:content>
               
                <Label text="I am Select Box" required="true"></Label>
                <Select id="idSel"  items="{/EmployeeSet}" change="onSelFromSelectionBox">
                    <items>
                        <core:Item text="{Name}" key="{Name}"></core:Item>  <!--//drop down item-->
                    </items>
                 
                </Select>

                 <Label text="I am Combo Box" required="true"></Label>
                <ComboBox id="idCb" items="{/EmployeeSet}" selectionChange="onSelFromCb">
                    <items>
                        <core:Item text="{Skill}" key="{Skill}"></core:Item>  <!--//drop down item-->
                    </items>
                 
                </ComboBox>

                 <Label text="I am Multi Combo Box" required="true"></Label>
                <MultiComboBox id="idMcb" items="{/EmployeeSet}" showSelectAll="true" selectionFinish="onSelFromMcb">
                    <items>
                        <core:Item text="{Design}" key="{Design}"></core:Item>  <!--//drop down item-->
                    </items>
                 
                </MultiComboBox>

                 <Label text="I am Radio Button Group Box" required="true"></Label>
                <RadioButtonGroup id="idRbg" buttons="{/EmployeeSet}" columns="2" selectedIndex="-1" select="onSelFromR"> 
                    <buttons>
                        <RadioButton text="{Status}"></RadioButton>
                    </buttons>
                 
                </RadioButtonGroup>

                
                 
            </f:content>
        </f:SimpleForm> 





<mvc:View controllerName="com.demo.sapui5.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <Page id="page" title="I am View1">
    <content>
    <Text id="idTxtWelcome" text="Welcome to SAPUI5" textAlign="Center" width="100%" class="sapMH1FontSize"></Text>

    <Label id="idLblName" text="Enter your name" required="true" class="sapUiTinyMarginBegin"></Label>
    <Input id="idIpName" width="30%" value="faizan" maxLength="10"  class="sapUiTinyMarginBegin" enabled="true"></Input>

<!-- //green button type=reject is red color-->

    <Button id="idBtnSubmit" text="Submit" type="Emphasized" class="sapUiTinyMarginBegin" press="onSubmit"></Button>

    <!-- <Button text="Go to second view" press="onPress"></Button> -->
    </content>

    <footer>
        <Bar>
            <contentRight>
                <Button text="Go to 2nd View" press="onPress"></Button>
            
            </contentRight>
        </Bar>
    </footer>
        
    </Page>
    
</mvc:View>
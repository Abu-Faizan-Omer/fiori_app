<mvc:View controllerName="com.demo.sapui5.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" xmlns:l="sap.ui.layout">
    
    <Page id="page" title="I am View1">
        <content>
        <Panel headerText="Employee Details" expandable="true" expanded="true">
            <l:Grid defaultSpan="L6 M6" vSpacing="0" >
                <l:content>
                    <Label text="Employee ID" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone No" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </l:content>

            </l:Grid>
          </Panel>  

          <Panel headerText="Family Details (2 fields per row)" expandable="true" >
            <l:Grid defaultSpan="L3 M3" vSpacing="0" >
                <l:content>
                    <Label text="Employee ID" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone No" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </l:content>

            </l:Grid>
          </Panel>  

          <Panel headerText="Personal  Details (3 fields per row)" expandable="true" >
            <l:Grid defaultSpan="L2 M2" vSpacing="0" >
                <l:content>
                    <Label text="Employee ID" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Name" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Designation" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Skill" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Email Id" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                    <Label text="Employee Phone No" class="sapUiTinyMarginTop"></Label>
                    <Input ></Input>
                </l:content>

            </l:Grid>
          </Panel>

           <Panel headerText="Zig Zag Pattern"  >
            <l:Grid  vSpacing="0" >
                <l:content>
                    <Label text="Employee ID" class="sapUiTinyMarginTop">
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Label>
                    <Input >
                        <layoutData>
                            <l:GridData span="L9 M9"></l:GridData>
                        </layoutData>
                    </Input>

                    <Label text="Employee Skill" class="sapUiTinyMarginTop">
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Label>
                    <Input >
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Input>

                    <Label text="Employee Designation" class="sapUiTinyMarginTop">
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Label>
                    <Input >
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Input>

                    <Label text="Employee Address" class="sapUiTinyMarginTop">
                        <layoutData>
                            <l:GridData span="L3 M3"></l:GridData>
                        </layoutData>
                    </Label>
                    <Input >
                        <layoutData>
                            <l:GridData span="L9 M9"></l:GridData>
                        </layoutData>
                    </Input>
                    
                </l:content>

            </l:Grid>
          </Panel>
    
        </content>
        
    </Page>
    
</mvc:View>
             <ScrollContainer vertical="true" horizontal="true">

         <Table items="{/EmployeeSet}" mode="SingleSelectLeft">
            <headerToolbar>
                <Toolbar >
                    <Title text="Employee List" ></Title>
                </Toolbar>
            </headerToolbar>
            <columns>
                
                <Column width="10rem">
                    <Text text="Employee Id"></Text>
                </Column>
                <Column width="10rem">
                    <Text text="Name"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Desig"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Skill"></Text>
                </Column>
                 <Column width="15rem">
                    <Text text="Email Id"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Phone No"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Salary"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Date of Joining"></Text>
                </Column>
                 <Column width="4rem">
                    <Text text="Rating"></Text>
                </Column>
                 <Column width="10rem">
                    <Text text="Status"></Text>
                </Column>
            </columns>

            <items>
                <ColumnListItem >
                    <cells>
                        
                        <Text text="{Empid}"></Text>
                        <Text text="{path:'Name', formatter :'.f.formatName'}"></Text>
                        <Text text="{Design}"></Text>
                        
                        <ObjectStatus text="{Skill}" state="{path:'Skill', formatter: '.f.colorSkill'}"></ObjectStatus>
                        <Text text="{Email}"></Text>
                        <Text text="{Phone}"></Text>
                        <Text text="{Salary}"></Text>
                        <Text text="{path:'Doj',formatter:'.f.formatDate'}"></Text>
                        <Text text="{Rating}"></Text>
                         <ObjectStatus text="{Status}" state="{path:'Status', formatter: '.f.colorStatus'}"></ObjectStatus>
                        
                    </cells>
                    
                </ColumnListItem>
            </items>
        </Table>
</ScrollContainer>



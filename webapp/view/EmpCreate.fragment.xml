<core:FragmentDefinition xmlns="sap.m"
 xmlns:core="sap.ui.core" 
 xmlns:f="sap.ui.layout.form"
 xmlns:u="sap.ui.unified">

<VBox >
<f:SimpleForm  title="Employee Details" editable="true" layout="ResponsiveGridLayout"
           emptySpanL="5" emptySpanM="5" >

           
             <f:content>
                <Label text="Employee ID" required="true"></Label>
                <Input id="idEmpId2" ></Input>
                <Label  text="Name" required="true" ></Label>
                <Input id="idName2" ></Input>
                 <Label text="Designation" required="true"></Label>
                <Input id="idDesign2" ></Input>
                 <Label text="Skill" required="true" ></Label>
                <Input id="idSkill2" ></Input>
                 <Label text="Email" required="true"></Label>
                <Input id="idEmail2" ></Input>
                 <Label text="Phone No" required="true"></Label>
                <Input id="idPhone2" ></Input>
                 <Label text="Salary" required="true"></Label>
                <Input id="idSalary2" ></Input>
                 <Label text="Date of Joining" required="true"></Label>
                <DatePicker id="idDoj2" ></DatePicker>
                 <Label text="Status" required="true"></Label>
                <Input id="idStatus2" ></Input>
                 <Label text="Rating" required="true"></Label>
                <RatingIndicator id="idRating2" ></RatingIndicator>
            </f:content>

</f:SimpleForm>


<Table items="{prjModel>/aProjects}">
<headerToolbar>
  <Toolbar >
    <Title text="Add Project"></Title>
    <ToolbarSpacer ></ToolbarSpacer>
    <Button icon="sap-icon://add" type="Emphasized" press="onPressAddRow"></Button>
  </Toolbar>
</headerToolbar>
  <columns>
    <Column >
      <Text text="Employee Id"></Text>
    </Column>
    <Column >
      <Text text="Project Code"></Text>
    </Column>
    <Column >
      <Text text="Client Name"></Text>
    </Column>
    <Column >
      <Text text="Project Name"></Text>
    </Column>
    <Column >
      <Text text="Description"></Text>
    </Column>
     <Column >
      <Text text="Team Size"></Text>
    </Column>
    <Column >
      <Text text="Delete"></Text>
    </Column>
  </columns>
  <items>
    <ColumnListItem >
      <cells>
        <Input value="{prjModel>Empid}"></Input>
        <Input value="{prjModel>Prjcode}"></Input>
        <Input value="{prjModel>Clientname}"></Input>
        <Input value="{prjModel>Prjname}"></Input>
        <Input value="{prjModel>Prjdesc}"></Input>
        <Input value="{prjModel>Teamsize}"></Input>
        <Button icon="sap-icon://delete" type="Reject" press="onPressDeleteRow"></Button>
      </cells>
    </ColumnListItem>
  </items>
</Table>

<!-- //this is for download -->
<f:SimpleForm editable="true" title="Add Profile Picture" layout="ResponsiveGridLayout"
          labelSpanL="4" labelSpanM="4" emptySpanL="3" emptySpanM="3">
  <f:content>
  <Label text="Select the Photo"></Label>
  <u:FileUploader id="idFileUploader" uploadUrl="/sap/opu/odata/sap/ZB70_EMP_SRV/PhotoSet" sendXHR="true" useMultipart="false"
  change="onChangeFile" uploadComplete="onPhotoUploadComplete"></u:FileUploader>
  <Label ></Label>
  <Button icon="sap-icon://upload" text="Upload" type="Emphasized" press="onUploadPhoto" width="100px"></Button>

  </f:content>
</f:SimpleForm>

</VBox>
</core:FragmentDefinition>